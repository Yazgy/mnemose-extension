{
  "name": "mnemose-extension",
  "description": "Companion browser extension for Mnemose — update watch progress from the streaming page.",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "compile": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^5.7.0",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  }
}
